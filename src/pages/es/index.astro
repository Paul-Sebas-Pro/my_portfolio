---
import MainLayout from "../../layouts/MainLayout.astro";
import SkillCategory from "../../components/SkillCategory.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { ui } from "../../i18n/ui";

const lang = "es";
const t = ui[lang];

const projects = await getCollection("projects", ({ id }) => {
  return id.startsWith("es/");
});

const sortedProjects = projects.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<MainLayout title="Inicio" lang={lang}>
  <main class="max-w-5xl mx-auto px-6 pt-32 pb-24">

    <section class="mb-32">
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
        {t['hero.title']}
      </h1>
      <p class="text-xl text-slate-400 max-w-2xl leading-relaxed">
        {t['hero.desc']}
      </p>
    </section>

    <section id="projects" class="mt-20">
      <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
        <span class="h-px w-12 bg-blue-500"></span>
        {t['projects.title']}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.subtitle}
            stack={project.data.stack}
            category={project.data.category}
            githubUrl={project.data.githubUrl}
            slug={project.id.split('/')[1].replace('.md', '')}
            lang={lang}
          />
        ))}
      </div>
    </section>

    <section id="skills" class="mt-20">
      <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
        <span class="h-px w-12 bg-blue-500"></span>
        {t['skills.title']}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <SkillCategory
          title={t['skills.frontend']}
          iconColor="bg-blue-500"
          skills={["React 19", "Next.js", "Svelte 5", "Vue 3.5", "Astro 5", "Tailwind CSS v4", "TypeScript"]}
        />

        <SkillCategory
          title={t['skills.backend']}
          iconColor="bg-emerald-500"
          skills={["Node.js", "Express 5", "PostgreSQL", "MongoDB", "Sequelize", "Prisma 7", "REST API"]}
        />

        <SkillCategory
          title={t['skills.devops']}
          iconColor="bg-orange-500"
          skills={["Docker", "Docker Compose", "GitHub Actions", "Linux", "CI/CD"]}
        />

        <SkillCategory
          title={t['skills.saas']}
          iconColor="bg-purple-500"
          skills={["Modelado DB", "Auth JWT", "Arquitectura MVC", "Vitest & Supertest"]}
        />
      </div>
    </section>

    <section id="about" class="mt-20">
      <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
        <span class="h-px w-12 bg-blue-500"></span>
        {t['about.title']}
      </h2>
      <div class="max-w-3xl">
        <p class="text-lg text-slate-400 leading-relaxed">
          {t['about.text']}
        </p>
      </div>
    </section>

    <section id="contact" class="mt-20">
      <h2 class="text-3xl font-bold mb-12 flex items-center gap-4">
        <span class="h-px w-12 bg-blue-500"></span>
        {t['contact.title']}
      </h2>
      <div class="max-w-3xl">
        <p class="text-lg text-slate-400 mb-8">
          {t['contact.desc']}
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="mailto:papou138@gmail.com"
            class="inline-flex items-center gap-2 bg-blue-500 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-600 transition-colors"
          >
            {t['contact.email']} — papou138@gmail.com
          </a>
          <a
            href="https://github.com/Paul-Sebas-Pro"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-slate-700 px-6 py-3 rounded-xl font-bold hover:bg-slate-800 transition-colors"
          >
            {t['contact.github']} — Paul-Sebas-Pro
          </a>
          <span class="inline-flex items-center gap-2 border border-slate-700 px-6 py-3 rounded-xl font-bold text-slate-500 cursor-not-allowed">
            {t['contact.malt']}
          </span>
        </div>
      </div>
    </section>

  </main>
</MainLayout>
