---
interface Props {
  title: string;
  description: string;
  icon: string;
  accentColor: string;
}

const { title, description, icon, accentColor } = Astro.props;
---

<div class="flex flex-col gap-3">
  <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-xl ${accentColor}`}>
    {icon}
  </div>
  <h3 class="text-lg font-semibold text-slate-100">{title}</h3>
  <p class="text-slate-400 text-sm leading-relaxed">{description}</p>
</div>
