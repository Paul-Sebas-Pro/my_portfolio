---
interface Testimonial {
  quote: string;
  author: string;
  role: string;
  company: string;
}

interface Props {
  items: Testimonial[];
}

const { items } = Astro.props;
---

<div class="grid md:grid-cols-2 gap-6">
  {
    items.map((t) => (
      <figure class="p-6 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col gap-4">
        <blockquote class="text-slate-300 text-sm leading-relaxed italic">
          "{t.quote}"
        </blockquote>
        <figcaption class="flex items-center gap-3 mt-auto">
          <div class="w-8 h-8 rounded-full bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400 text-xs font-bold">
            {t.author.charAt(0)}
          </div>
          <div>
            <p class="text-slate-200 text-sm font-semibold">{t.author}</p>
            <p class="text-slate-500 text-xs">{t.role} · {t.company}</p>
          </div>
        </figcaption>
      </figure>
    ))
  }
</div>
