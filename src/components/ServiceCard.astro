---
interface Props {
  title: string;
  description: string;
  icon: string;
  href?: string;
}

const { title, description, icon, href } = Astro.props;
const cls =
  "group p-6 rounded-2xl border border-slate-800 bg-slate-900/50 hover:border-blue-500/50 hover:bg-slate-900 transition-all duration-300";
---

{
  href ? (
    <a href={href} class={cls + " block"}>
      <div class="text-3xl mb-4">{icon}</div>
      <h3 class="text-lg font-semibold text-slate-100 mb-2 group-hover:text-blue-400 transition-colors">
        {title}
      </h3>
      <p class="text-slate-400 text-sm leading-relaxed">{description}</p>
      <span class="inline-block mt-3 text-xs text-blue-400 font-medium group-hover:translate-x-1 transition-transform">
        En savoir plus →
      </span>
    </a>
  ) : (
    <div class={cls}>
      <div class="text-3xl mb-4">{icon}</div>
      <h3 class="text-lg font-semibold text-slate-100 mb-2 group-hover:text-blue-400 transition-colors">
        {title}
      </h3>
      <p class="text-slate-400 text-sm leading-relaxed">{description}</p>
    </div>
  )
}
