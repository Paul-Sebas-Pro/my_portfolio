---
interface Props {
  title: string;
  subtitle?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  subtitle,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section
  class="rounded-2xl border border-blue-500/20 bg-gradient-to-br from-blue-600/10 to-cyan-500/5 px-10 py-14 text-center my-24"
>
  <h2
    class="text-3xl md:text-4xl font-extrabold mb-4 text-slate-100"
    style="font-family: var(--font-heading)"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="text-slate-400 text-lg mb-8 max-w-xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    )
  }
  <div class="flex flex-wrap gap-4 justify-center">
    <a
      href={primaryHref}
      class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-xl font-bold transition-colors"
    >
      {primaryLabel} →
    </a>
    {
      secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class="inline-flex items-center gap-2 border border-slate-700 hover:border-slate-500 text-slate-300 px-8 py-4 rounded-xl font-bold transition-colors"
        >
          {secondaryLabel}
        </a>
      )
    }
  </div>
</section>
