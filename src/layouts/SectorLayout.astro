---
import MainLayout from "./MainLayout.astro";
import CTASection from "../components/CTASection.astro";

interface UseCase {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  tagline: string;
  sectorName: string;
  challenges: string;
  solution: string;
  benefits: string[];
  useCases: UseCase[];
  lang?: "fr" | "en" | "es";
}

const {
  title,
  description,
  h1,
  tagline,
  sectorName,
  challenges,
  solution,
  benefits,
  useCases,
  lang = "fr",
} = Astro.props;

const services = [
  { icon: "🌐", label: "Création de site vitrine", href: `/${lang}/services/creation-site-vitrine/` },
  { icon: "🔧", label: "Maintenance & évolution", href: `/${lang}/services/maintenance-site-web/` },
  { icon: "⚡", label: "Automatisation métier", href: `/${lang}/services/automatisation-pme/` },
  { icon: "🔗", label: "Intégrations & API", href: `/${lang}/services/integration-api-crm/` },
];
---

<MainLayout title={title} lang={lang} description={description}>
  <main class="max-w-3xl mx-auto px-6 pt-32 pb-24">

    <!-- Breadcrumb + Hero -->
    <section class="mb-20">
      <nav class="text-sm text-slate-500 mb-8">
        <a href={`/${lang}/`} class="hover:text-slate-300 transition-colors">Accueil</a>
        <span class="mx-2">›</span>
        <span class="text-slate-400">{title}</span>
      </nav>
      <h1
        class="text-3xl md:text-5xl font-extrabold tracking-tight mb-6 leading-tight"
        style="font-family: var(--font-heading)"
      >
        {h1}
      </h1>
      <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">{tagline}</p>
    </section>

    <!-- Défis numériques du secteur -->
    <section class="mb-16">
      <h2
        class="text-xl font-bold mb-4 text-slate-200 flex items-center gap-3"
        style="font-family: var(--font-heading)"
      >
        <span class="h-px w-8 bg-red-500/60 shrink-0"></span>
        Vos défis numériques
      </h2>
      <p class="text-slate-400 leading-relaxed">{challenges}</p>
    </section>

    <!-- Cas d'usage concrets -->
    <section class="mb-16">
      <h2
        class="text-xl font-bold mb-6 text-slate-200 flex items-center gap-3"
        style="font-family: var(--font-heading)"
      >
        <span class="h-px w-8 bg-cyan-500/60 shrink-0"></span>
        Cas d'usage pour {sectorName}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {useCases.map((u) => (
          <div class="flex items-start gap-3 p-4 rounded-xl border border-slate-800 bg-slate-900/40">
            <span class="text-2xl">{u.icon}</span>
            <div>
              <p class="font-semibold text-slate-200 text-sm">{u.title}</p>
              <p class="text-slate-500 text-xs mt-0.5">{u.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Ce que je propose -->
    <section class="mb-16 rounded-2xl border border-blue-500/20 bg-blue-600/5 p-8">
      <h2
        class="text-xl font-bold mb-4 text-blue-300 flex items-center gap-3"
        style="font-family: var(--font-heading)"
      >
        <span class="h-px w-8 bg-blue-500 shrink-0"></span>
        Mon approche pour {sectorName}
      </h2>
      <p class="text-slate-300 leading-relaxed">{solution}</p>
    </section>

    <!-- Bénéfices -->
    <section class="mb-16">
      <h2
        class="text-xl font-bold mb-6 text-slate-200 flex items-center gap-3"
        style="font-family: var(--font-heading)"
      >
        <span class="h-px w-8 bg-emerald-500/60 shrink-0"></span>
        Ce que vous obtenez
      </h2>
      <ul class="space-y-3">
        {benefits.map((b) => (
          <li class="flex items-start gap-3 text-slate-300">
            <span class="text-emerald-400 mt-0.5 shrink-0 font-bold">✓</span>
            {b}
          </li>
        ))}
      </ul>
    </section>

    <!-- Services -->
    <section class="mb-16">
      <h2
        class="text-xl font-bold mb-6 text-slate-200 flex items-center gap-3"
        style="font-family: var(--font-heading)"
      >
        <span class="h-px w-8 bg-blue-500/60 shrink-0"></span>
        Mes services pour {sectorName}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {services.map((s) => (
          <a
            href={s.href}
            class="flex items-center gap-3 px-4 py-3 rounded-xl border border-slate-800 bg-slate-900/40 hover:border-blue-500/40 hover:bg-slate-900 transition-all group"
          >
            <span class="text-xl">{s.icon}</span>
            <span class="text-sm font-medium text-slate-300 group-hover:text-blue-400 transition-colors">
              {s.label}
            </span>
            <span class="ml-auto text-slate-600 group-hover:text-blue-400 transition-colors text-xs">→</span>
          </a>
        ))}
      </div>
    </section>

    <CTASection
      title={`Un projet numérique pour votre activité ${sectorName} ?`}
      subtitle="Entretien découverte gratuit, sans engagement. Je réponds sous 24h."
      primaryLabel="Discuter de votre projet"
      primaryHref={`/${lang}/#contact`}
      secondaryLabel="Voir mes services"
      secondaryHref={`/${lang}/#services`}
    />
  </main>
</MainLayout>
