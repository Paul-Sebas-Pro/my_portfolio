---
import MainLayout from "./MainLayout.astro";
import CTASection from "../components/CTASection.astro";

interface ProcessStep {
  title: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  tagline: string;
  problem: string;
  solution: string;
  benefits: string[];
  process: ProcessStep[];
  ctaTitle: string;
  ctaSubtitle?: string;
  lang?: "fr" | "en" | "es";
}

const {
  title,
  description,
  h1,
  tagline,
  problem,
  solution,
  benefits,
  process,
  ctaTitle,
  ctaSubtitle,
  lang = "fr",
} = Astro.props;
---

<MainLayout title={title} lang={lang} description={description}>
  <main class="max-w-3xl mx-auto px-6 pt-32 pb-24">

    <!-- Breadcrumb + Hero -->
    <section class="mb-20">
      <nav class="text-sm text-slate-500 mb-8">
        <a href={`/${lang}/`} class="hover:text-slate-300 transition-colors">Accueil</a>
        <span class="mx-2">›</span>
        <a href={`/${lang}/#services`} class="hover:text-slate-300 transition-colors">Services</a>
        <span class="mx-2">›</span>
        <span class="text-slate-400">{title}</span>
      </nav>
      <h1
        class="text-3xl md:text-5xl font-extrabold tracking-tight mb-6 leading-tight"
        style="font-family: var(--font-heading)"
      >
        {h1}
      </h1>
      <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">{tagline}</p>
    </section>

    <!-- Problème -->
    <section class="mb-16">
      <h2 class="text-xl font-bold mb-4 text-slate-200 flex items-center gap-3" style="font-family: var(--font-heading)">
        <span class="h-px w-8 bg-red-500/60 shrink-0"></span>
        Le problème que vous rencontrez
      </h2>
      <p class="text-slate-400 leading-relaxed">{problem}</p>
    </section>

    <!-- Solution -->
    <section class="mb-16 rounded-2xl border border-blue-500/20 bg-blue-600/5 p-8">
      <h2 class="text-xl font-bold mb-4 text-blue-300 flex items-center gap-3" style="font-family: var(--font-heading)">
        <span class="h-px w-8 bg-blue-500 shrink-0"></span>
        Comment je peux vous aider
      </h2>
      <p class="text-slate-300 leading-relaxed">{solution}</p>
    </section>

    <!-- Bénéfices -->
    <section class="mb-16">
      <h2 class="text-xl font-bold mb-6 text-slate-200 flex items-center gap-3" style="font-family: var(--font-heading)">
        <span class="h-px w-8 bg-emerald-500/60 shrink-0"></span>
        Ce que vous obtenez
      </h2>
      <ul class="space-y-3">
        {benefits.map((b) => (
          <li class="flex items-start gap-3 text-slate-300">
            <span class="text-emerald-400 mt-0.5 shrink-0 font-bold">✓</span>
            {b}
          </li>
        ))}
      </ul>
    </section>

    <!-- Process -->
    <section class="mb-16">
      <h2 class="text-xl font-bold mb-8 text-slate-200 flex items-center gap-3" style="font-family: var(--font-heading)">
        <span class="h-px w-8 bg-cyan-500/60 shrink-0"></span>
        Comment ça se passe
      </h2>
      <ol class="space-y-6">
        {process.map((step, i) => (
          <li class="flex gap-5">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-400 text-sm font-bold flex items-center justify-center">
              {i + 1}
            </span>
            <div>
              <p class="font-semibold text-slate-200 mb-1">{step.title}</p>
              <p class="text-slate-400 text-sm leading-relaxed">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <CTASection
      title={ctaTitle}
      subtitle={ctaSubtitle}
      primaryLabel="Discuter de votre projet"
      primaryHref={`/${lang}/#contact`}
      secondaryLabel="Voir tous les services"
      secondaryHref={`/${lang}/#services`}
    />
  </main>
</MainLayout>
