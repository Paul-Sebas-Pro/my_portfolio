---
import "../styles/global.css";
import { ui } from "../i18n/ui";

interface Props {
  title: string;
  lang: "fr" | "en" | "es";
  description?: string;
}

const { title, lang, description } = Astro.props;
const t = ui[lang as keyof typeof ui];

const metaDescription =
  description ??
  (lang === "fr"
    ? "Développeur Full-Stack freelance — sites web, automatisation et intégrations sur mesure pour PME et acteurs locaux. Réponse sous 24h."
    : lang === "en"
      ? "Freelance Full-Stack Developer — custom websites, automation and integrations for SMEs. Response within 24h."
      : "Desarrollador Full-Stack freelance — sitios web, automatización e integraciones a medida para pymes. Respuesta en 24h.");

const siteUrl = (Astro.site?.toString() ?? "https://paul-sebas.dev").replace(/\/$/, "");
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(fr|en|es)/, "") || "/";
const canonicalUrl = `${siteUrl}${currentPath}`;
const hreflangUrls = {
  fr: `${siteUrl}/fr${pathWithoutLang === "/" ? "/" : pathWithoutLang}`,
  en: `${siteUrl}/en${pathWithoutLang === "/" ? "/" : pathWithoutLang}`,
  es: `${siteUrl}/es${pathWithoutLang === "/" ? "/" : pathWithoutLang}`,
};

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Paul Sebas",
  jobTitle: lang === "fr" ? "Développeur Full-Stack Freelance" : lang === "en" ? "Freelance Full-Stack Developer" : "Desarrollador Full-Stack Freelance",
  email: "paul.sebas.freelance@free.fr",
  url: `${siteUrl}/${lang}/`,
  sameAs: [
    "https://www.linkedin.com/in/paul-sebas-pro",
    "https://github.com/Paul-Sebas-Pro",
  ],
};
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      rel="stylesheet"
      href="https://fonts.bunny.net/css?family=inter:400,500,600,700|space-grotesk:500,600,700&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Paul Sebas — Dev Full-Stack</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr" href={hreflangUrls.fr} />
    <link rel="alternate" hreflang="en" href={hreflangUrls.en} />
    <link rel="alternate" hreflang="es" href={hreflangUrls.es} />
    <link rel="alternate" hreflang="x-default" href={hreflangUrls.fr} />
    <meta property="og:title" content={`${title} | Paul Sebas — Dev Full-Stack`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}/og-default.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : lang === "en" ? "en_US" : "es_ES"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Paul Sebas`} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og-default.png`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="bg-slate-950 text-slate-50 antialiased selection:bg-blue-500/30">
    <nav
      class="fixed top-0 w-full z-50 border-b border-slate-800 bg-slate-950/80 backdrop-blur-md"
    >
      <div
        class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between"
      >
        <a
          href={`/${lang}`}
          class="flex items-center gap-2.5 hover:opacity-80 transition-opacity"
        >
          <img src="/logo.svg" alt="" aria-hidden="true" class="h-8 w-8 rounded-lg" />
          <span class="font-bold text-xl tracking-tighter">
            Paul<span class="text-blue-500">.</span>Sebas
          </span>
        </a>

        <div class="flex items-center gap-8">
          <ul class="hidden md:flex gap-6 text-sm font-medium text-slate-400">
            <li>
              <a href={`/${lang}/#services`} class="hover:text-white transition-colors"
                >{t["nav.services"]}</a>
            </li>
            <li>
              <a href={`/${lang}/case-studies/`} class="hover:text-white transition-colors"
                >{t["nav.realisations"]}</a>
            </li>
            <li>
              <a href={`/${lang}/blog/`} class="hover:text-white transition-colors"
                >{t["nav.blog"]}</a>
            </li>
            <li>
              <a href={`/${lang}/#contact`} class="hover:text-white transition-colors"
                >{t["nav.contact"]}</a>
            </li>
          </ul>

          <div class="flex gap-2">
            {
              lang !== "fr" && (
                <a
                  href="/fr/"
                  class="text-xs font-bold border border-slate-700 px-2 py-1 rounded hover:bg-slate-800 transition-all"
                >
                  FR
                </a>
              )
            }
            {
              lang !== "en" && (
                <a
                  href="/en/"
                  class="text-xs font-bold border border-slate-700 px-2 py-1 rounded hover:bg-slate-800 transition-all"
                >
                  EN
                </a>
              )
            }
            {
              lang !== "es" && (
                <a
                  href="/es/"
                  class="text-xs font-bold border border-slate-700 px-2 py-1 rounded hover:bg-slate-800 transition-all"
                >
                  ES
                </a>
              )
            }
          </div>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="border-t border-slate-800 mt-20 pt-12 pb-8 bg-slate-950">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
          <div>
            <a href={`/${lang}/`} class="flex items-center gap-2 mb-4 hover:opacity-80 transition-opacity">
              <img src="/logo.svg" alt="" aria-hidden="true" class="h-6 w-6 rounded opacity-70" />
              <span class="font-bold text-sm text-slate-200">Paul<span class="text-blue-500">.</span>Sebas</span>
            </a>
            <p class="text-slate-500 text-xs leading-relaxed">Développeur Full-Stack freelance. PME et acteurs locaux.</p>
          </div>
          <div>
            <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-3">Services</p>
            <ul class="space-y-2">
              <li><a href={`/${lang}/services/creation-site-vitrine/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Création site vitrine</a></li>
              <li><a href={`/${lang}/services/maintenance-site-web/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Maintenance web</a></li>
              <li><a href={`/${lang}/services/automatisation-pme/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Automatisation PME</a></li>
              <li><a href={`/${lang}/services/integration-api-crm/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Intégration API / CRM</a></li>
            </ul>
          </div>
          <div>
            <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-3">Contenu</p>
            <ul class="space-y-2">
              <li><a href={`/${lang}/case-studies/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">{t["nav.realisations"]}</a></li>
              <li><a href={`/${lang}/blog/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Blog</a></li>
              <li><a href={`/${lang}/#projects`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">{t["nav.projects"]}</a></li>
            </ul>
          </div>
          <div>
            <p class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-3">Zones</p>
            <ul class="space-y-2">
              <li><a href={`/${lang}/zones/martinique/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Martinique</a></li>
              <li><a href={`/${lang}/zones/guadeloupe/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Guadeloupe</a></li>
              <li><a href={`/${lang}/zones/france/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">France</a></li>
              <li><a href={`/${lang}/zones/antilles/`} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">Antilles</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-slate-900 pt-6 flex flex-col md:flex-row justify-between items-center gap-3">
          <p class="text-slate-600 text-xs">© 2026 — {t["footer.madeWith"]}</p>
          <div class="flex gap-5">
            <a href="https://www.linkedin.com/in/paul-sebas-pro" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-white text-sm transition-colors">LinkedIn</a>
            <a href="https://github.com/Paul-Sebas-Pro" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-white text-sm transition-colors">GitHub</a>
            <a href={`/${lang}/#contact`} class="text-slate-500 hover:text-white text-sm transition-colors">{t["nav.contact"]}</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
